{
  "type": "object",
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "report_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DEF-[0-9]{3}$"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 25
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "default": 2
    },
    "cursor": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  },
  "required": []
}
