{
  "type": "object",
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^DEF-[0-9]{3}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^TC-[A-Z0-9-]{1,16}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^DEF-[0-9]{3}:TC-[A-Z0-9-]{1,16}$"
    },
    "assertion": {
      "type": "string",
      "enum": [
        "accepts_without_optional_comment"
      ]
    },
    "preview_lines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40,
      "default": 6
    }
  },
  "required": [
    "report_id",
    "case_id",
    "idempotency_key",
    "assertion"
  ]
}
